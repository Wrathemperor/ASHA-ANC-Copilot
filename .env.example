# Option B: GCP Project ID (if running on Google Cloud Run or with GOOGLE_APPLICATION_CREDENTIALS)
FIRESTORE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

